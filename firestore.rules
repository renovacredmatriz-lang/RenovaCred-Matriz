rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      let docSnap = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return docSnap != null ? docSnap.data : null;
    }

    function isMaster() {
      return isSignedIn() && getUserData() != null && getUserData().role == 'MASTER';
    }

    function isCredor() {
      return isSignedIn() && getUserData() != null && getUserData().role == 'CREDOR';
    }

    function canAccessEmpresa(empresaId) {
      return isSignedIn() &&
             empresaId is string &&
             empresaId != "" &&
             (!isCredor() || (isCredor() && getUserData() != null && getUserData().empresaId == empresaId));
    }

    function hasEmpresa(doc) {
      return doc != null && 'empresaId' in doc && doc.empresaId is string && doc.empresaId != "";
    }

    // USERS
    match /users/{userId} {
      allow read: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow create, delete: if isMaster();
    }

    // EMPRESAS
    match /empresas/{id} {
      allow read: if isSignedIn();
      allow create: if isMaster() || (isSignedIn() && !isCredor());
      allow update, delete: if isMaster();
    }

    // AUX DATA
    match /auxData/{id} {
      allow read: if isSignedIn();
      allow write: if isMaster();
    }

    // STATS
    match /stats/{id} {
      allow read: if isSignedIn();
      allow write: if isMaster();
    }

    // NEGOCIACOES
    match /negociacoes/{id} {
      allow read: if isSignedIn();
      allow create: if canAccessEmpresa(request.resource.data.empresaId);
      allow update: if isSignedIn() && canAccessEmpresa(request.resource.data.empresaId);
      allow delete: if isMaster();
    }

    // MOVIMENTACOES
    match /movimentacoes/{id} {
      allow read: if isSignedIn();
      allow create: if canAccessEmpresa(request.resource.data.empresaId);
      allow update: if isSignedIn() && canAccessEmpresa(request.resource.data.empresaId);
      allow delete: if isMaster();
    }

    // PARCELAS
    match /parcelas/{id} {
      allow read: if isSignedIn();
      allow create: if canAccessEmpresa(request.resource.data.empresaId);
      allow update: if isSignedIn() && canAccessEmpresa(request.resource.data.empresaId);
      allow delete: if isMaster();
    }

    // CLIENTES
    match /clientes/{id} {
      allow read: if isSignedIn();
      allow create: if canAccessEmpresa(request.resource.data.empresaId);
      allow update: if isSignedIn() && canAccessEmpresa(request.resource.data.empresaId);
      allow delete: if isMaster();
    }

    // AGENDAMENTOS
    match /agendamentos/{id} {
      allow read: if isSignedIn() && canAccessEmpresa(resource.data.empresaId);
      allow create: if canAccessEmpresa(request.resource.data.empresaId);
      allow update: if isSignedIn() && canAccessEmpresa(request.resource.data.empresaId);
      allow delete: if isMaster();
    }
  }
}
